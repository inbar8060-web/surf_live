# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
# Bypasses RLS: every use must sit behind a role guard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin, used to build invite links and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Every club lives at <slug>.<this>; the operator area at admin.<this>.
# Locally, *.localhost resolves to this machine with no DNS setup.
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000
# Development only: a phone on the LAN cannot resolve <slug>.localhost, so the
# bare address (192.168.x.x:3000, localhost:3000) opens this club instead.
NEXT_PUBLIC_DEV_CLUB_SLUG=surfer-live

# Support assistant (Claude). Optional — the support thread works without it.
ANTHROPIC_API_KEY=

# Google Maps Platform key with the Places API (New) and Time Zone API enabled.
# Reads a club's listing — address, hours, phone, website, pin — from its Maps
# link when a club is added. Optional — without it only the link itself is read.
GOOGLE_MAPS_API_KEY=

# 32+ random bytes, base64. Used to HMAC invite tokens and CSRF tokens.
# Generate with: openssl rand -base64 48
APP_SECRET=

# ---------------------------------------------------------------------------
# Payments (adapter: stripe | mock)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret of the Connect webhook endpoint (events from the clubs' own accounts).
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Mail (adapter: log — the real provider is added later)
# ---------------------------------------------------------------------------
# Signed documents are emailed to the member and the club and kept nowhere else.
MAIL_PROVIDER=log
MAIL_FROM=Surfer Live <no-reply@example.com>

# ---------------------------------------------------------------------------
# Surf conditions (Open-Meteo needs no key; leave as is for the free tier)
# ---------------------------------------------------------------------------
MARINE_API_BASE=https://marine-api.open-meteo.com/v1/marine
WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast
